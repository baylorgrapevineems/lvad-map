# ─── SharePoint / Azure AD (provided by BSW IT) ──────────────────────────────
# Required to store patient data in SharePoint Online.
# Leave blank to fall back to local JSON file (development only).

AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Full URL of the SharePoint site where the LVAD_Patients list lives.
# Example: https://bswh.sharepoint.com/sites/EMS
SHAREPOINT_SITE_URL=https://yourorg.sharepoint.com/sites/YourSite

# Name of the SharePoint list (default: LVAD_Patients)
SP_PATIENTS_LIST=LVAD_Patients

# ─── Optional: legacy Upstash Redis (only used if SharePoint vars are absent) ─
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ─── Server port (optional, defaults to 3001) ────────────────────────────────
# PORT=3001
